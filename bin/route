#!/usr/bin/env node
import { serve } from '../src/proxy.mjs';
import { resolve as resolveJob, jobs } from '../src/policy.mjs';

const [cmd, ...args] = process.argv.slice(2);
const flag = (name, def) => {
  const i = args.indexOf(`--${name}`);
  return i >= 0 ? args[i + 1] : def;
};

switch (cmd) {
  case 'serve':
    serve(Number(flag('port', process.env.ROUTE_PORT || 8787)));
    break;
  case 'policy': {
    console.log('job'.padEnd(20), 'tier'.padEnd(12), 'model');
    for (const j of jobs()) {
      const r = resolveJob(j);
      console.log(j.padEnd(20), r.tier.padEnd(12), `${r.model}  (${r.provider}, was ${r.was})`);
    }
    break;
  }
  case 'bench': {
    const { run } = await import('../src/bench.mjs');
    await run({ n: Number(flag('n', 0)) || undefined, only: flag('only') });
    break;
  }
  case 'audit':
  case 'estate':
  case 'plans': {
    const { run } = await import('../src/estate.mjs');
    // --plan claude-code=200,codex=20   --billing openclaw=api   --source codex,kimi   --yes (never ask)
    const pairs = (s) => Object.fromEntries((s || '').split(',').filter(Boolean).map((kv) => kv.split('=')));
    const plans = Object.fromEntries(Object.entries(pairs(flag('plan'))).map(([k, v]) => [k, Number(v)]));
    const ask = cmd === 'plans' ? 'always' : args.includes('--yes') ? 'never' : 'auto';
    await run({ reveal: args.includes('--reveal'), plans, billing: pairs(flag('billing')), only: flag('source')?.split(','), ask });
    break;
  }
  case 'escalate': {
    const { run } = await import('../src/escalate.mjs');
    await run();
    break;
  }
  case 'frontier': {
    const { run } = await import('../src/frontier.mjs');
    await run();
    break;
  }
  case 'sweep': {
    const { run } = await import('../src/sweep.mjs');
    await run({ bar: Number(flag('bar', 90)) });
    break;
  }
  case 'replay': {
    const { run } = await import('../src/replay.mjs');
    await run({ days: Number(flag('days', 0)) || undefined });
    break;
  }
  default:
    console.log(`route — find out what your agents cost, then make them cost less

START HERE — no API key needed, reads your machine, takes a few seconds:

  route audit                 what you spend, per tool and project, and how much can move today
                              reads Claude Code, Codex, Kimi Code, Hermes and OpenClaw logs;
                              the first run asks how you pay for each tool (once)
  route plans                 answer those questions again (plan changed, new tool)

THEN, to act on it:

  route serve [--port 8787]   OpenAI-compatible endpoint that routes each job
  route policy                show the routing table

GOING DEEPER — prove it on your own workload (needs NEBIUS_API_KEY):

  route sweep [--bar 90]      score every Token Factory model, pick the cheapest that passes
  route bench [--n 20]        head-to-head against a stronger model, blind-judged
  route frontier              the same tasks on Claude, measured (needs ANTHROPIC_API_KEY)
  route escalate              cheap-first with an automatic upgrade when the answer looks weak
  route replay                re-price your whole history under the policy
  route audit --reveal        same audit, with real project names instead of labels
  route audit --plan codex=20,claude-code=200
                              compare subscription value against what you pay per month
  route audit --billing openclaw=api
                              correct a tool's billing mode when detection can't tell
  route audit --source codex,kimi
                              only read these tools
  route audit --yes           never ask; use saved answers and detection only

Everything writes JSON to results/ so you can diff it, chart it, or gate CI on it.
`);
    process.exit(cmd ? 1 : 0);
}
